# ==========================================
# APNA SCHEDULER (Personal Scheduler OS)
# Environment Configuration
# ==========================================

# Port and Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas URI)
# Example: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/apna_scheduler?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/apna_scheduler

# JWT Secret for Session & API Authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=7d

# Internal Tick Secret (Used by GitHub Actions / Render Wakeups)
# Header: X-Tick-Secret: your_internal_tick_secret_token
INTERNAL_TICK_SECRET=your_secure_internal_tick_secret_key_here

# Google OAuth 2.0 Credentials
# In Google Cloud Console: Set Authorized redirect URI to: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Telegram Bot Configuration
# Create a bot via @BotFather on Telegram to obtain the token
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567
# Authorized Telegram Chat IDs (comma-separated if multiple)
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
# Set to 'true' to enable polling in development, or use webhook in production
TELEGRAM_POLLING_ENABLED=false
# Webhook URL (if using webhook mode in production on Render)
TELEGRAM_WEBHOOK_URL=https://your-scheduler-api.onrender.com/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_verification_token

# Scheduler & Engine Configuration
SCHEDULER_ENABLED=true
# Internal tick interval in milliseconds (default: 30000 = 30s)
SCHEDULER_TICK_INTERVAL_MS=30000
# Default Timezone (IANA Timezone Name)
DEFAULT_TIMEZONE=Asia/Kolkata
# Maximum allowed execution time in milliseconds (default: 60000 = 60s)
DEFAULT_EXECUTION_TIMEOUT_MS=60000
# Stuck job lock expiry in milliseconds (default: 300000 = 5 minutes)
STUCK_JOB_TIMEOUT_MS=300000

# Security & SSRF Protection
# Comma-separated allowed external domains (optional allowlist; leave empty for public internet)
ALLOWED_DOMAINS=
# Allow localhost / private IP targets (STRICTLY for local debugging only! Set false in production)
ALLOW_PRIVATE_NETWORK_TARGETS=false
